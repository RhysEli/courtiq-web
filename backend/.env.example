PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-your-key-here
DB_PATH=./data/courtiq.db
UPLOAD_DIR=./data/uploads
# Same Supabase project as DATABASE_URL -- Project Settings > API in the
# Supabase dashboard. Service role key (not anon) since uploads are
# server-side only, gated by our own requireRole/requireTeamAccess checks,
# not Supabase Row Level Security.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
